# PostgreSQL (used by compose.yaml and the backend)
POSTGRES_DB=employee_portal
POSTGRES_USER=employee_portal
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
BACKGROUND_CHECK_API_URL=https://54capvm12g.execute-api.ap-northeast-2.amazonaws.com
BACKGROUND_CHECK_TIMEOUT_SECONDS=10

# Frontend
VITE_API_BASE_URL=http://localhost:8000

SEED_ADMIN_PASSWORD=replace-with-a-development-admin-password
SEED_EMPLOYEE_PASSWORD=replace-with-a-development-employee-password
ALLOW_SEED=false
